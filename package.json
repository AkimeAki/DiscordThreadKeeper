{
	"name": "thread-keeper",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "node --env-file=.env --env-file=.env.development.local ./src/main.ts",
		"start": "prisma migrate deploy && node ./src/main.ts",
		"set-commands": "node --env-file=.env ./src/set-commands.ts",
		"delete-commands": "node --env-file=.env ./src/delete-commands.ts",
		"format": "prettier --write .",
		"lint": "tsc --noEmit && eslint .",
		"test": "vitest run",
		"lint:fix": "npm run lint -- --fix && npm run format",
		"db:init": "npm run db:deploy",
		"db:generate": "dotenv -e .env.development.local -- prisma generate",
		"db:migrate": "dotenv -e .env.development.local -- prisma migrate dev",
		"db:deploy": "dotenv -e .env.development.local -- prisma migrate deploy"
	},
	"dependencies": {
		"better-sqlite3": "13.0.3",
		"discord.js": "14.27.0",
		"kysely": "0.29.7",
		"prisma": "5.22.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@tsconfig/strictest": "2.0.8",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "24.19.2",
		"dotenv-cli": "11.0.0",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-prisma": "5.0.0",
		"prettier-plugin-sh": "0.20.2",
		"prisma-kysely": "1.8.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vitest": "5.0.5"
	},
	"allowScripts": {
		"@prisma/engines@5.22.0": true,
		"@prisma/engines@5.3.1": true,
		"prisma@5.22.0": true,
		"better-sqlite3": false
	}
}
